# ==========================================
# Canteen Management System - Environment Variables
# ==========================================

# --- MongoDB Atlas Connection ---
# Replace with your actual Atlas connection string from step 2
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/canteen_db?retryWrites=true&w=majority

# --- Backend Server Configuration ---
PORT=8080
HOST=127.0.0.1
DATA_DIR=backend/data

# --- Frontend API Endpoint ---
VITE_API_BASE_URL=http://localhost:8080/api
